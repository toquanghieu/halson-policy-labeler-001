# Host processes (API and/or worker) against the compose infrastructure:
#   docker compose up -d postgres elasticmq seaweedfs init
#   set -a; . ./.env.homelab; set +a; make worker          # e.g. a worker using the local claude CLI
DATABASE_URL=postgresql+psycopg://labeler:labeler@localhost:5432/labeler
QUEUE_BACKEND=sqs
SQS_ENDPOINT_URL=http://localhost:9324
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=labeler
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
EMBEDDED_WORKER=false
METRICS_PORT=9101
LLM_PROVIDER=claude_cli
MAX_CONCURRENCY=4
