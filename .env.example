# API keys. Any of them can instead be typed on the Settings page (stored encrypted; see
# SECRETS_BACKEND below). A key here is used whenever nothing is stored there.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COMPAT_API_KEY=            # for the OpenAI-compatible endpoint (Gemini, Groq, OpenRouter; Ollama needs none)

# Provider for both tiers, unless TIER1_PROVIDER / TIER2_PROVIDER (or the Settings page) say otherwise:
# anthropic | openai | openai_compat | slm (distilled local model) | claude_cli (local `claude` login, dev) | fake
LLM_PROVIDER=anthropic
# TIER1_PROVIDER=openai_compat
# TIER2_PROVIDER=anthropic
# OPENAI_BASE_URL=https://api.openai.com/v1
# COMPAT_BASE_URL=http://localhost:11434/v1   # Ollama; or https://generativelanguage.googleapis.com/v1beta/openai, https://api.groq.com/openai/v1, https://openrouter.ai/api/v1
TIER1_MODEL=claude-haiku-5-5
TIER1_EFFORT=low
TIER2_MODEL=claude-opus-5-5
TIER2_EFFORT=medium
ESCALATE_BELOW_CONFIDENCE=0.6
ROUTER_DISAGREE_THRESHOLD=0.5
MAX_CONCURRENCY=8
# Per-posting budget (both tiers, retries) and the queue's visibility timeout. The first must be at
# most the second minus 30 s, or a slow posting would be picked up twice; startup refuses otherwise.
# LABEL_DEADLINE_S=240
# QUEUE_VISIBILITY_TIMEOUT_S=300

# ---- infrastructure ---------------------------------------------------------------
# Unset = single process: SQLite at data/app.db, in-memory queue, worker inside the API,
# objects under data/objects. docker-compose.yml sets these for its containers (Postgres,
# ElasticMQ, SeaweedFS); .env.homelab.example has the values for host processes.
# DATABASE_URL=postgresql+psycopg://labeler:labeler@localhost:5432/labeler
# QUEUE_BACKEND=sqs                       # memory | sqs
# SQS_ENDPOINT_URL=http://localhost:9324  # unset on AWS
# STORAGE_BACKEND=s3                      # local | s3
# S3_ENDPOINT_URL=http://localhost:8333   # unset on AWS
# S3_BUCKET=labeler
# EMBEDDED_WORKER=true                    # false when separate workers consume the queue

# ---- secrets ------------------------------------------------------------------------
# env: keys only from the environment (read-only) · db: Settings-page keys encrypted in the database
# (default) · aws: AWS Secrets Manager under SECRETS_PREFIX (production; IAM task role, no key here)
# SECRETS_BACKEND=db
# SECRETS_KEY=        # Fernet master key for `db`; empty = generated once into data/secrets.key (0600, gitignored)
# SECRETS_PREFIX=policy-labeler/
